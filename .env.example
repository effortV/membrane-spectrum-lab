# Copy to .env and fill locally. Never commit or paste secrets into prompts.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
XPS_MAIN_MODEL=deepseek-ai/DeepSeek-V4-Pro
XPS_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

OPENALEX_API_KEY=
OPENALEX_MAILTO=
ELSEVIER_API_KEY=
# Optional when your Elsevier account/institution provides an institutional token.
ELSEVIER_INSTTOKEN=

XPS_PROJECT_ROOT=D:\zzh\XPS-agent
XPS_STORAGE_ROOT=D:\data\XPS-agent
XPS_WORKSPACE_ROOT=D:\data\XPS-agent\workspace
XPS_DATA_ROOT=D:\data\XPS-agent\raw\tables
XPS_REFERENCE_ROOT=D:\data\XPS-agent\raw\literature
XPS_LEGACY_ROOT=D:\data\XPS-agent\raw\spectra

# Cost/safety controls. Per-action network limit includes retry attempts.
XPS_LLM_TIMEOUT_SECONDS=600
XPS_LLM_STREAM_ENABLED=true
XPS_REQUEST_TIMEOUT_SECONDS=1800
XPS_LLM_TIMEOUT_RETRIES=0
XPS_LLM_MAX_RETRIES=4
XPS_LLM_MAX_REQUESTS_PER_ACTION=24
# Vision has a separate inactivity timeout; ambiguous timeouts are not resubmitted.
XPS_VISION_TIMEOUT_SECONDS=600
XPS_VISION_TIMEOUT_RETRIES=0
XPS_VISION_MAX_ATTEMPTS=2
# Cooperative batch deadline: stops BEFORE the next request, not provider billing.
XPS_ACTION_TIMEOUT_SECONDS=3600
XPS_VISION_MAX_PAGES_PER_PDF=4
XPS_DOWNLOAD_RATE_SECONDS=1.0
